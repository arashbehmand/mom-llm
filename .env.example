# ===========================================
# MoM (Mixture of Models) — environment
# ===========================================
# Secrets and machine-local facts live here; everything about *models and ensembles*
# lives in the YAML config instead. See docs/CONFIGURATION.md#environment--settings.
#
# This file is read from the working directory and from beside any config on the search path
# (~/.mom/.env, ./.mom/.env, ...), project before user, first definition wins. The process
# environment wins over all of them. Provider keys can also go in an `auth.json` next to a
# config — a flat {"ANTHROPIC_API_KEY": "sk-..."} object, chmod 600.
# `mom config where` lists which files were consulted (names only, never values).

# --- core ---------------------------------------------------------------

# Path to your v2 config YAML (legacy alias: MOM_CONFIG_PATH). OPTIONAL: without it mom
# searches ~/.mom/config.yaml (or $XDG_CONFIG_HOME/mom/config.yaml) and ./mom.yaml (or
# ./.mom/config.yaml) and merges them. Setting it PINS one file and turns that search off.
# Run `mom config where` to see what is being used. See docs/CONFIGURATION.md.
# MOM_CONFIG="mom.yaml"

# Optional file deep-merged last, over everything else — for deployment-local values
# (e.g. server.public_url) that shouldn't sit in the tracked config. Each config on the search
# path also picks up a sibling override automatically (mom.yaml -> mom.override.yaml).
# MOM_CONFIG_OVERLAY="config.local.yaml"

# Borrow API keys from opencode's auth.json (type: "api" entries only, lowest precedence).
# Off unless set; also available as `--auth-from-opencode`.
# MOM_AUTH_FROM_OPENCODE=1

# Where the response cache and usage-metrics SQLite files live. Defaults to the
# platform data dir (macOS: ~/Library/Application Support/mom-llm).
# MOM_DATA_DIR="./data"

# The bearer token clients must present when the config sets `auth: bearer`
# (legacy alias: API_TOKEN).
MOM_API_TOKEN="your-secret-bearer-token"

# Bind address for `mom serve` (also settable with --host/--port).
# MOM_HOST="127.0.0.1"
# MOM_PORT="8000"

# --- provider API keys --------------------------------------------------
# Add only the providers your config actually uses.

OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="..."
GEMINI_API_KEY="..."
OPENROUTER_API_KEY="..."
# XAI_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY, GROQ_API_KEY, PERPLEXITY_API_KEY, ...

# Per-model outbound proxy, read from whatever env var a model's `proxy_url_env` names.
# MUSE_SPARK_PROXY_URL="http://user:password@us-proxy.example:8080"

# --- optional -----------------------------------------------------------

# Langfuse tracing (enable it under `observability.langfuse` in the config).
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Redis, only needed to share progress events across several worker processes;
# unset, the progress event bus is in-memory (legacy alias: REDIS_URL).
# MOM_REDIS_URL="redis://localhost:6379"

# Logging. At INFO each request narrates itself (fan-out, per-member dispatch and completion,
# synthesis, totals); WARNING keeps only problems. Never logs message content.
# MOM_LOG_LEVEL="INFO"
# MOM_LOG_FORMAT="text"          # text | json
# MOM_LITELLM_DEBUG="false"      # verbose upstream logging (legacy alias: LITELLM_VERBOSE)

# NOTE: CORS is no longer an env var — it moved into the config YAML under `server.cors`.
