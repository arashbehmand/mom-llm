# ===========================================
# MoM (Mixture of Models) — environment
# ===========================================
# Secrets and machine-local facts live here; everything about *models and ensembles*
# lives in the YAML config instead. See docs/CONFIGURATION.md#environment--settings.
# The process environment wins over this file.

# --- core ---------------------------------------------------------------

# Path to your v2 config YAML (legacy alias: MOM_CONFIG_PATH).
MOM_CONFIG="config.yaml"

# Optional file deep-merged over MOM_CONFIG — for deployment-local values
# (e.g. server.public_url) that shouldn't sit in the tracked config.
# MOM_CONFIG_OVERLAY="config.local.yaml"

# Where the response cache and usage-metrics SQLite files live. Defaults to the
# platform data dir (macOS: ~/Library/Application Support/mom-llm).
# MOM_DATA_DIR="./data"

# The bearer token clients must present when the config sets `auth: bearer`
# (legacy alias: API_TOKEN).
MOM_API_TOKEN="your-secret-bearer-token"

# Bind address for `mom serve` (also settable with --host/--port).
# MOM_HOST="127.0.0.1"
# MOM_PORT="8000"

# --- provider API keys --------------------------------------------------
# Add only the providers your config actually uses.

OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="..."
GEMINI_API_KEY="..."
OPENROUTER_API_KEY="..."
# XAI_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY, GROQ_API_KEY, PERPLEXITY_API_KEY, ...

# Per-model outbound proxy, read from whatever env var a model's `proxy_url_env` names.
# MUSE_SPARK_PROXY_URL="http://user:password@us-proxy.example:8080"

# --- optional -----------------------------------------------------------

# Langfuse tracing (enable it under `observability.langfuse` in the config).
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Redis, only needed to share progress events across several worker processes;
# unset, the progress event bus is in-memory (legacy alias: REDIS_URL).
# MOM_REDIS_URL="redis://localhost:6379"

# Logging.
# MOM_LOG_LEVEL="INFO"
# MOM_LOG_FORMAT="text"          # text | json
# MOM_LITELLM_DEBUG="false"      # verbose upstream logging (legacy alias: LITELLM_VERBOSE)

# NOTE: CORS is no longer an env var — it moved into the config YAML under `server.cors`.
