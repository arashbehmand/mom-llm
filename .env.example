# ===========================================
# MoM (Mixture of Models) Service Configuration
# ===========================================

# A secret token that clients must provide in the Authorization header
API_TOKEN="your-secret-bearer-token"

# Comma-separated list of allowed CORS origins, Leave empty to disable CORS restrictions
ALLOWED_CORS_ORIGINS=""

# Set to "true" to enable verbose logging from LiteLLM library (useful for debugging)
LITELLM_VERBOSE="false"

# Add API keys for the LLM providers you plan to use
OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY="..."
ANTHROPIC_API_KEY="..."
OPENROUTER_API_KEY="..."

# Optional outbound HTTP(S) proxy for Muse Spark requests (use a US exit IP)
MUSE_SPARK_PROXY_URL="http://user:password@us-proxy.example:8080"

# Langfuse Integration (Optional)

LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
